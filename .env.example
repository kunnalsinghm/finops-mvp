# Copy this file to .env and fill in values as needed. Everything works
# without any of these set - they're optional enhancements.

# Slack Incoming Webhook URL for budget/burn-rate alerts (free Slack feature).
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

PORT=4000

# Which storage backend to use: "sqlite" (default) or "postgres". See
# README "Deployment modes" for when you'd want each.
FINOPS_DB_DRIVER=

# Required only when FINOPS_DB_DRIVER=postgres. Standard Postgres
# connection string, e.g. postgres://user:pass@host:5432/dbname
FINOPS_POSTGRES_URL=

# Set to "true" to enable schema-per-tenant multi-tenancy (requires
# FINOPS_DB_DRIVER=postgres). See server/tenancy.js and README "Deployment
# modes" - this is NOT something to flip on for a single-team deployment.
FINOPS_MULTI_TENANT=

# Only relevant with FINOPS_MULTI_TENANT=true. The shared schema that holds
# tenant/API-key/user routing data (which tenant a request belongs to,
# before it's routed to that tenant's own schema). Defaults to
# "control_plane".
FINOPS_CONTROL_PLANE_SCHEMA=

# Host to bind the server to. Defaults to 127.0.0.1 (only reachable from
# this machine). Set to 0.0.0.0 only if you deliberately want other devices
# on your network (or a tunnel/port-forward) to reach it, and understand
# that this exposes the auth-bootstrap window - see README "Bootstrap mode".
FINOPS_HOST=

# Where the SQLite database file lives. Defaults to data/finops.db.
FINOPS_DB_PATH=

# How many past backups to keep before pruning the oldest. Defaults to 7.
FINOPS_BACKUP_RETENTION=

# Semantic (near-duplicate) caching on the proxy - opt-in per request via
# the X-Enable-Semantic-Cache header, separate from exact-match caching.
# mode: "local" (default, zero-dependency word-overlap) or "embedding"
FINOPS_SEMANTIC_CACHE_MODE=

# Similarity threshold (0-1). Defaults: 0.92 for local mode, 0.90 for embedding.
FINOPS_SEMANTIC_CACHE_THRESHOLD=

# Required only for embedding mode: a real OpenAI key used solely to compute
# embeddings (kept separate from the per-request X-Provider-Key, which is
# never stored). Anthropic proxy requests also use OpenAI's embeddings API
# in this mode, since Anthropic has no first-party embeddings endpoint.
FINOPS_EMBEDDING_API_KEY=

# Shadow A/B testing (opt-in per request via X-Enable-Shadow-Test on the
# proxy) - sends a sample of real traffic to the recommended cheaper model
# in parallel, purely to measure output similarity and real cost delta.
# Default fraction of eligible requests actually shadow-tested when enabled
# (0-1). Can be overridden per-request via X-Shadow-Test-Sample-Rate.
FINOPS_SHADOW_TEST_SAMPLE_RATE=

# How many successful shadow samples for a given (current -> suggested)
# model pair before /api/recommendations upgrades that pair's confidence
# from "unverified" to a real measured verdict. Defaults to 5.
FINOPS_SHADOW_TEST_MIN_SAMPLES=

# Average similarity (0-1) above which a shadow-tested pair is marked
# "shadow-tested-similar" instead of "shadow-tested-diverges". Defaults to 0.8.
FINOPS_SHADOW_TEST_SIMILARITY_THRESHOLD=

# Generic webhook for budget/burn-rate alerts (Discord, Teams, ntfy.sh,
# PagerDuty, or your own receiver) - alongside or instead of Slack.
# Posts JSON: { text, timestamp }
FINOPS_WEBHOOK_URL=

# Email delivery for budget/burn-rate alerts via any SMTP account (e.g. a
# free Gmail account with an app password, or your own mail server).
# All five must be set for email delivery to activate.
FINOPS_SMTP_HOST=
FINOPS_SMTP_PORT=
FINOPS_SMTP_USER=
FINOPS_SMTP_PASS=
FINOPS_ALERT_EMAIL_FROM=
FINOPS_ALERT_EMAIL_TO=

# --- Governance hardening (all optional; defaults shown) ---

# Refuse proxy requests from API keys that aren't bound to a team. Team
# budgets, model allow-lists and quotas can only be enforced against a key
# that is bound to a team (PATCH /api/keys/:keyId { "team": "..." }); an
# unbound key falls back to the self-declared X-Team header, which a caller
# can simply omit. Recommended wherever budgets are a real control.
FINOPS_STRICT_IDENTITY=false

# What to do with a model that has no price at all (not in the catalogue, no
# override, no family match): "flag" (forward it, record it as unpriced, raise
# an alert) or "block" (422 before calling the provider).
FINOPS_UNPRICED_POLICY=flag

# Milliseconds to wait for the upstream provider (whole request when not
# streaming; time-to-first-byte when streaming) before answering 504.
FINOPS_UPSTREAM_TIMEOUT_MS=120000

# "open" (default): if the usage store fails AFTER a provider call, still
# return the response and spool the event to disk for `npm run replay-spool`.
# "closed": additionally refuse (503) BEFORE forwarding if the usage store is
# unreachable, so no request can spend money that can't be recorded.
FINOPS_METERING_FAILURE_POLICY=open

# Where failed-to-record usage events are spooled (default: data/metering-spool.jsonl)
FINOPS_SPOOL_PATH=
