+// already transaction-safe to hand to the callback as-is. See postgres.js
+// for why that backend needs a materially different implementation.
+async function transaction(fn) {
+  raw.exec("BEGIN");
+  try {
+    const result = await fn({ get, all, run });
+    raw.exec("COMMIT");
+    return result;
+  } catch (err) {
+    try {
+      raw.exec("ROLLBACK");
+    } catch {
+      // ROLLBACK can itself fail if BEGIN never actually started a
+      // transaction (e.g. the error above came from a syntax error before
+      // any statement ran) - the original error is what matters to the caller.
+    }
+    throw err;
+  }
+}
+
+module.exports = { dialect, get, all, run, exec, transaction, raw, ready: Promise.resolve() };
