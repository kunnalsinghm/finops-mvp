diff --git a/test/helpers/dbTestSetup.js b/test/helpers/dbTestSetup.js
new file mode 100644
index 0000000..8897dbf
--- /dev/null
+++ b/test/helpers/dbTestSetup.js
@@ -0,0 +1,86 @@
+// test/helpers/dbTestSetup.js
+//
+// Call setup(name) at the very top of a test file, BEFORE requiring
+// server/storage or any production module that reaches it - storage/index.js
+// picks its driver and (for Postgres) opens its connection pool at require
+// time, reading these same env vars, so they must already be set.
+//
+// Mirrors this project's existing SQLite isolation convention (a unique
+// FINOPS_DB_PATH per test file, keyed by pid, cleaned up in test.after) and
+// extends the same idea to Postgres: a unique schema per test file instead
+// of a unique file, so parallel/unrelated test files never collide over
+// shared tables like usage_events or api_keys. Test files themselves don't
+// need to know or care which backend is active - they just call
+// storage.get/all/run and let this helper handle the plumbing underneath.
+
+const path = require("path");
+const fs = require("fs");
+const crypto = require("crypto");
+
+function setup(name) {
+  const isPostgres = process.env.FINOPS_DB_DRIVER === "postgres";
+
+  if (isPostgres) {
+    if (!process.env.FINOPS_POSTGRES_URL) {
+      throw new Error(
+        "FINOPS_DB_DRIVER=postgres but FINOPS_POSTGRES_URL is not set - point it at a real Postgres instance to run tests against this backend."
+      );
+    }
+    // Lowercased deliberately: postgres.js's CREATE SCHEMA quotes this name
+    // (preserving exact case), but the search_path passed via the pool's
+    // `-c search_path=...` connection option is UNQUOTED, so Postgres folds
+    // it to lowercase per standard SQL identifier rules. A mixed-case name
+    // (e.g. from a camelCase test file name like "shadowTest") would create
+    // a schema the pool's own search_path then can't find, since the two
+    // resolve to different identifiers - caught by actually running this
+    // against a real Postgres instance, not by inspection.
+    const schema = `test_${name}_${process.pid}_${crypto.randomBytes(3).toString("hex")}`.toLowerCase();
+    process.env.FINOPS_POSTGRES_SCHEMA = schema;
+
+    async function cleanup() {
+      // Wait for this process's own schema-creation to finish before
+      // dropping it - a test file with few/no DB calls could otherwise
+      // reach cleanup while the storage module's CREATE TABLE statements
+      // (kicked off unawaited at require time) are still in flight,
+      // racing the DROP SCHEMA against them.
+      try {
+        await require("../../server/storage").ready;
+      } catch {
+        // schema init itself failed - nothing to await further, still want
+        // to attempt the drop below in case it partially succeeded
+      }
+      const { Pool } = require("pg");
+      const p = new Pool({ connectionString: process.env.FINOPS_POSTGRES_URL });
+      try {
+        await p.query(`DROP SCHEMA IF EXISTS "${schema}" CASCADE`);
+      } finally {
+        await p.end();
+      }
+    }
+
+    return { cleanup, dialect: "postgres" };
+  }
+
+  const dbPath = path.join(__dirname, "..", `.tmp-${name}-${process.pid}.db`);
+  process.env.FINOPS_DB_PATH = dbPath;
+
+  async function cleanup() {
+    try {
+      const storage = require("../../server/storage");
+      storage.raw?.close();
+    } catch {
+      // already closed, or never opened - fine either way for cleanup purposes
+    }
+    for (const suffix of ["", "-shm", "-wal"]) {
+      try {
+        fs.unlinkSync(dbPath + suffix);
+      } catch {
+        // file never existed - fine
+      }
+    }
+  }
+
+  return { cleanup, dialect: "sqlite" };
+}
+
+module.exports = { setup };
